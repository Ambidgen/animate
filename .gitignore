# renders and intermediates are rebuilt by the tools
**/frames/
**/renders/
**/review/*-vs-ref.*
node_modules/
__pycache__/
# built files (tools/build.mjs makes them from src/ + kit/ + the style)
plugins/**/index.html
plugins/**/review/

# per-piece build output (regenerated by render/render.mjs)
pieces/*/node_modules/
pieces/*/renders/*.wav
